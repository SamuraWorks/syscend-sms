APP_NAME="Syscend Campus"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Freetown

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ─── Seeds ───────────────────────────────────────────────
# Temporary password assigned to platform accounts created by AdminSeeder
# (syscend@gmail.com, ministry@syscend.com, district@syscend.com).
# Mandatory for production; if unset the seeder falls back to a known default.
SEED_ADMIN_PASSWORD=

# ─── Installation (single-school deployment) ──────────────
# The school this installation owns. Platform/ministry users resolve school
# context to this school on school routes. Leave empty to auto-detect when
# the database holds exactly one school; ambiguous setups fail closed (404).
INSTALLATION_SCHOOL_ID=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Serverless / read-only filesystems must log to stderr instead of the daily
# file channel: the entrypoint already does this when LOG_CHANNEL is unset.
# LOG_CHANNEL=stderr
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ───────────────────────────────
# Any PostgreSQL provider works: local, Railway, Supabase, RDS.
#
# Supabase (Project Settings -> Database -> Connection string -> Session pooler):
#   DB_HOST       aws-1-<region>.pooler.supabase.com
#   DB_PORT       5432
#   DB_DATABASE   postgres
#   DB_USERNAME   postgres.<project-ref>     <- note the .<project-ref> suffix
#   DB_PASSWORD   <database password>
#   DB_SSLMODE    require
#
# Prefer the pooler over the direct host. The direct host
# (db.<project-ref>.supabase.co) is IPv6-only, so it is unreachable from
# hosts without IPv6 egress. Port 6543 is the transaction pooler and is a
# poor fit for apps that rely on session state or LISTEN/NOTIFY.
#
# Alternatively supply a single DATABASE_URL and the values above are ignored.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=syscend
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Sessions and the cache both live in PostgreSQL (the sessions, cache and
# jobs migrations cover them), so state survives server restarts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ShouldQueue jobs (email/SMS blasts) run inline when sync. Set database only
# when a queue worker is running alongside the app.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ─── Scheduled jobs ───────────────────────────────────────
# Shared secret required as a bearer token by GET /api/cron/{job}.
# Mandatory in production: the endpoint fails closed while it is empty.
CRON_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@syscend.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── Gemini AI ───────────────────────────────────────────
# Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── SMS Gateway (Vonage default, Twilio alternative) ────
# Credentials configured per-school via school_settings table
SMS_PROVIDER=vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SENDER_ID=Syscend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Orange Money (Mobile Money) ─────────────────────────
# Credentials configured per-school via school_settings table
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_USER=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_RETURN_URL="${APP_URL}/school/fees/payments/callback?method=orange_money"
ORANGE_MONEY_CANCEL_URL="${APP_URL}/school/fees/payments/callback?method=orange_money&status=cancelled"
ORANGE_MONEY_WEBHOOK_URL="${APP_URL}/api/v1/payments/webhook/orange-money"

# Platform-level webhook signing key for subscription payments.
# REQUIRED in production: webhooks are rejected (503) when unset.
ORANGE_MONEY_PLATFORM_API_KEY=

# ─── Afrimoney (Mobile Money) ────────────────────────────
# Credentials configured per-school via school_settings table
AFRIMONEY_API_KEY=
AFRIMONEY_APP_ID=
AFRIMONEY_APP_SECRET=

# ─── Monime (Sierra Leone payments: MoMo, card, bank) ─────
# Business Space credentials from https://my.monime.io
# MONIME_WEBHOOK_SECRET is REQUIRED in production: webhooks are rejected (503) when unset.
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=
MONIME_SUCCESS_URL="${APP_URL}/super-admin/subscriptions?payment=success"
MONIME_CANCEL_URL="${APP_URL}/super-admin/subscriptions?payment=cancelled"
MONIME_WEBHOOK_URL="${APP_URL}/api/v1/webhooks/monime"
MONIME_BASE_URL=https://api.monime.io/v1
MONIME_CHECKOUT_URL=https://checkout.monime.io
MONIME_API_VERSION=caph.2025-08-23

# ─── File storage ─────────────────────────────────────────
# local keeps uploads on disk (development). s3 switches the local, private
# and public disks to an object store, which is required on platforms whose
# filesystem is read only or ephemeral - without it student photos, imports
# and report card templates fail on upload.
STORAGE_DRIVER=local

# Supabase Storage (S3 compatible), or any S3/MinIO/R2 endpoint:
#   AWS_ACCESS_KEY_ID          <storage access key>
#   AWS_SECRET_ACCESS_KEY      <storage secret>
#   AWS_DEFAULT_REGION         eu-west-1
#   AWS_BUCKET                 <private bucket> (private/local disks)
#   AWS_PUBLIC_BUCKET          <public bucket> (public disk; defaults to AWS_BUCKET)
#   AWS_ENDPOINT               https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_USE_PATH_STYLE_ENDPOINT=true
#   AWS_PUBLIC_URL             https://<project-ref>.supabase.co/storage/v1/object/public/<PUBLIC bucket>
#   AWS_PUBLIC_PREFIX=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=eu-west-1
#AWS_BUCKET=
#AWS_PUBLIC_BUCKET=
#AWS_ENDPOINT=
#AWS_USE_PATH_STYLE_ENDPOINT=true
#AWS_PUBLIC_URL=

# ─── Production / serverless checklist ────────────────────
# Set these in the hosting environment (they are NOT read from this file
# when .env is absent, for example on Vercel):
#   APP_ENV=production          APP_DEBUG=false
#   APP_URL=https://your.domain LOG_CHANNEL=stderr
#   CRON_SECRET=<random 32+ chars>
#   STORAGE_DRIVER=s3 + the AWS_* block above
# Scheduler entries run as Vercel Cron against /api/cron/{job}; a serverless
# deployment has no queue worker, so keep QUEUE_CONNECTION=sync.

# ─── Railway Deployment (optional overrides) ─────────────
# Railway auto-sets these, but you can override:
# RAILWAY_STATIC_URL=
# NPM_CONFIG_PRODUCTION=true
