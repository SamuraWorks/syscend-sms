<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="syscend_campus_testing"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_USERNAME" value="postgres"/>
        <!-- DB_PASSWORD intentionally omitted: provided via .env / CI secret, never committed -->
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- CACHE_STORE is what config/cache.php reads on Laravel 11+. The old
             CACHE_DRIVER name is ignored, which left the file cache enabled
             during tests and made the rate limiter write to disk on every
             request (flaky on Windows). Set both. -->
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- routes/web.php registers the entire estate (~700 routes). The CLI
             default of 128M is not enough to boot the app for every test file
             in one process, and the suite dies partway through with
             "Allowed memory size exhausted" while loading routes. -->
        <ini name="memory_limit" value="2G"/>
    </php>
</phpunit>
