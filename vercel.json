{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/build/(.*)",
      "destination": "/api/assets.php"
    },
    {
      "source": "/(favicon.ico|robots.txt|favicon.png|apple-touch-icon.png|manifest.json|site.webmanifest)",
      "destination": "/api/assets.php"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api/assets.php"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ],
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(favicon.ico|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-subscriptions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/check-escalations",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/archive-old-records",
      "schedule": "0 0 1 * *"
    }
  ]
}
